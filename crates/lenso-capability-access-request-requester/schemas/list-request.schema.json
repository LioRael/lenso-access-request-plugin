{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["organization_id", "limit"],
  "properties": {
    "organization_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "type": "string", "enum": ["pending", "provisioning", "approved", "denied", "cancelled", "expired", "intervention_required"] },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
