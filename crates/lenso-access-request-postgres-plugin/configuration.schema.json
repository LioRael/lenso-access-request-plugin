{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "database_url_secret", "auth_issuer", "auth_assertion_public_key", "requester_callers", "admin_callers", "worker_callers", "requestable_bundles"],
  "properties": {
    "schema": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" },
    "database_url_secret": { "type": "string", "minLength": 1, "maxLength": 240 },
    "auth_issuer": { "type": "string", "minLength": 1, "maxLength": 240 },
    "auth_assertion_public_key": { "type": "string", "minLength": 1, "maxLength": 512, "x-lenso-sensitive": true },
    "requester_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "admin_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "worker_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "requestable_bundles": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bundle_id", "role_mode", "role_id", "role_name", "scope_kind", "permissions", "allow_non_members"],
        "properties": {
          "bundle_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role_mode": { "type": "string", "enum": ["existing", "managed"] },
          "role_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "scope_kind": { "type": "string", "minLength": 1, "maxLength": 160 },
          "permissions": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "allow_non_members": { "type": "boolean" }
        }
      }
    },
    "expiring_lead_seconds": { "type": "integer", "minimum": 60, "maximum": 604800, "default": 86400 },
    "max_notification_attempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 },
    "notification_retry_seconds": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 60 }
  }
}
